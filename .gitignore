# ===================
# BACKEND (Python/FastAPI)
# ===================

# Python
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc
*.pyc
__pycache__/
.Python
*.py[cod]
*$py.class

# Environment
backend/.env
backend/.env.production
backend/.env.local
!backend/.env.example
!backend/.env.production.template

# Uploads (user data)
backend/uploads/original/*
backend/uploads/optimized/*
!backend/uploads/original/.gitkeep
!backend/uploads/optimized/.gitkeep

# Test files
backend/test_*.py
backend/debug_*.py
backend/sample_*.txt
backend/optimized_resume_sample.txt

# Admin/Auth tokens (generated files)
backend/admin_token.txt
backend/*.token

# Development docs (not needed in production)
backend/DAY1_PROGRESS_REPORT.md
backend/FIXED_JSON_PARSING.md
backend/SETUP_LOCAL.md

# Alembic
backend/alembic/versions/*.pyc

# Supabase
backend/.supabase/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

